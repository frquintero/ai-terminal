# Agent Backend Configuration
# AGENT_TYPE options: minimax, kimi2, groq (default), custom
AGENT_TYPE=groq

# Groq Configuration
# Get API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# MiniMax M2 Configuration
# MINIMAX_M2_API_KEY=your_api_key_here
# MINIMAX_MODEL=MiniMax-M2

# Custom OpenAI-Compatible Endpoint
# CUSTOM_API_KEY=your_custom_api_key
# CUSTOM_MODEL=your_model_name
# CUSTOM_BASE_URL=https://api.example.com/v1

# Model Parameters (shared across all backends)
MAX_TOKENS=1024
TEMPERATURE=0.7
HIDE_THINKING=true
MAX_STEPS=15

# Output display settings
SHOW_RAW_OUTPUT=false           # Show raw command outputs (default: false for clean summaries)
RAW_OUTPUT_MAX_CHARS=4000       # Max chars to display when raw output is enabled

# Python Sandbox settings
SANDBOX_PATH=./sandbox_runs     # Directory for sandbox execution environments
SANDBOX_PYTHON=                 # Path to sandbox Python interpreter (optional, defaults to system Python)
SANDBOX_TIMEOUT=30              # Default timeout in seconds for sandbox execution
SANDBOX_MAX_CPU_SEC=20          # Maximum CPU time in seconds
SANDBOX_MAX_MEM_MB=1024         # Maximum memory in MB
SANDBOX_MAX_FSIZE_MB=50         # Maximum file size in MB
SANDBOX_DISABLE_NETWORK=1       # Disable network access in sandbox (1=yes, 0=no)
SANDBOX_ALLOW_PROJECT_WRITES=0  # Allow writing to project directory from sandbox (1=yes, 0=no, default: no for safety)
